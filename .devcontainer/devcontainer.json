{
  "name": "EpiVerse GitHub LAB - Python 3.12",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "remoteUser": "vscode",
  "postCreateCommand": "python3 scripts/verify_lab.py && python3 -m unittest discover -s tests -v",
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "ms-python.vscode-pylance", "redhat.vscode-yaml"],
      "settings": {"python.defaultInterpreterPath": "/usr/local/bin/python"}
    }
  }
}
